<mxCell id="r3" value="1:N" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#e94560;strokeWidth=2;fontSize=12;fontStyle=1;" edge="1" parent="1" source="products_0" target="order_items_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r4" value="1:N" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#e94560;strokeWidth=2;fontSize=12;fontStyle=1;" edge="1" parent="1" source="categories_0" target="products_7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="notes" value="&lt;b&gt;Relações&lt;/b&gt;&lt;br&gt;• 1 utilizador faz N encomendas (orders.user_id)&lt;br&gt;• 1 encomenda tem N linhas (order_items.order_id, ON DELETE CASCADE)&lt;br&gt;• 1 produto aparece em N linhas (order_items.product_id, ON DELETE SET NULL)&lt;br&gt;• 1 categoria agrupa N produtos (products.categoria_id, ON DELETE SET NULL)&lt;br&gt;&lt;br&gt;&lt;b&gt;orders.estado&lt;/b&gt;: pendente · em processamento · enviada · entregue · cancelada" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="600" height="150" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>